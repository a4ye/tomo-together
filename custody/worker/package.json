{
  "name": "custody-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker port of custody/ (Express 4 + mongodb + viem + Unifold).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:schema": "wrangler d1 execute tomo-together-custody --remote --file=../../migration/schema-custody.sql",
    "d1:seed": "wrangler d1 execute tomo-together-custody --remote --file=../../migration/out/seed-custody.sql"
  },
  "dependencies": {
    "hono": "4.6.14",
    "@unifold/node": "0.5.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "22",
    "typescript": "^5.6.0",
    "wrangler": "4.127.1"
  }
}
