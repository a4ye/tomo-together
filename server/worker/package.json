{
  "name": "tomo-yard-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker port of server/index.js (Express 4 + mongodb + ws + multer).",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:schema": "wrangler d1 execute tomo-together --remote --file=../../migration/schema-app.sql",
    "d1:seed": "wrangler d1 execute tomo-together --remote --file=../../migration/out/seed-app.sql"
  },
  "dependencies": {
    "hono": "4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.6.0",
    "wrangler": "4.127.1"
  }
}
